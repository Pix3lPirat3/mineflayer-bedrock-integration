# mineflayer-bedrock-integration - submodule spec (DRAFT 2026-09-23, nothing pushed yet)
#
# An experimentation umbrella: each bedrock-related fork/branch as a submodule, pinned so the whole stack is coordinated.
# Clone with:  git clone --recurse-submodules <url>   (then: npm run bootstrap)
# This is NOT a PR target - it is a "frankenstein" integration env combining our + zuri's (+ others') bedrock branches.
#
# Bump a submodule to its branch tip (e.g. after zuri pushes to #1327):
#   git submodule update --remote deps/minecraft-data && npm run bootstrap && git commit -am "bump minecraft-data"

[submodule "deps/mineflayer"]
	path = deps/mineflayer
	url = https://github.com/Pix3lPirat3/mineflayer.git
	branch = feat/bedrock-edition-adapter

[submodule "deps/prismarine-chunk"]
	path = deps/prismarine-chunk
	url = https://github.com/Pix3lPirat3/prismarine-chunk.git
	branch = feat/bedrock-1.26-chunks

[submodule "deps/node-minecraft-data"]
	path = deps/node-minecraft-data
	url = https://github.com/Pix3lPirat3/node-minecraft-data.git
	# NOTE: local worktree is at detached commit d449f39 ("bedrock-protocol workflow renamed"); it is the wrapper that
	# consumes deps/minecraft-data and needs `npm run generate:data` re-run against zuri's data. DECISION NEEDED: which
	# branch to track (push d449f39 to a named bedrock branch on the fork), else pin the commit.
	branch = master

[submodule "deps/minecraft-data"]
	path = deps/minecraft-data
	url = https://github.com/mc-zuri/minecraft-data.git
	# zuri's #1327 - "Bedrock data from each server for every version 1.16.201 to 1.26.51". The bootstrap links this into
	# deps/node-minecraft-data/minecraft-data and regenerates the wrapper index (a plain file swap is not enough).
	branch = bedrock-block-states-collision

[submodule "deps/bedrock-protocol"]
	path = deps/bedrock-protocol
	url = https://github.com/Pix3lPirat3/bedrock-protocol.git
	# local worktree bp-813 at commit 07bb2a1 on fix/nethernet-connectiontype (post #813 nethernet-identity merge).
	branch = fix/nethernet-connectiontype

[submodule "deps/prismarine-physics"]
	path = deps/prismarine-physics
	url = https://github.com/Pix3lPirat3/prismarine-physics.git
	branch = feat/bedrock-edition

[submodule "deps/prismarine-registry"]
	path = deps/prismarine-registry
	# NOTE: local checkout is PR #57 head (commit ae29e1c, "build fix") off PrismarineJS/prismarine-registry. DECISION
	# NEEDED: point at the PR author's fork+branch (fetchable), or fork it to Pix3lPirat3 and track a branch there.
	url = https://github.com/PrismarineJS/prismarine-registry.git
	branch = master
